{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": [
    "vllm"
  ],
  "properties": {
    "vllm": {
      "type": "object",
      "required": [
        "ttt"
      ],
      "properties": {
        "ttt": {
          "type": "object",
          "required": [
            "huggingface",
            "api"
          ],
          "properties": {
            "huggingface": {
              "type": "object",
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "type": "string",
                  "description": "The Hugging Face model to use",
                  "default": "mistralai/Mistral-7B-Instruct-v0.3",
                  "title": "HuggingFace model"
                },
                "chatTemplate": {
                  "description": "Custom chat template for the model. Leave empty to use the model's default.",
                  "title": "Chat template file"
                },
                "secretName": {
                  "description": "Optional name of existing secret containing HUGGING_FACE_HUB_TOKEN environment variable. Must be in namespace with the same name as platform.",
                  "title": "Existing HuggingFace token secret"
                }
              }
            },
            "api": {
              "type": "object",
              "required": [
                "cacheVolume"
              ],
              "properties": {
                "cacheVolume": {
                  "type": "object",
                  "required": [
                    "resources"
                  ],
                  "properties": {
                    "resources": {
                      "type": "object",
                      "required": [
                        "requests"
                      ],
                      "properties": {
                        "requests": {
                          "type": "object",
                          "required": [
                            "storage"
                          ],
                          "properties": {
                            "storage": {
                              "type": "string",
                              "description": "Storage request for the cache volume used for pulling models.",
                              "default": "40Gi",
                              "title": "Model Storage"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "modelMaxContextLength": {
                  "description": "Max context length for the vLLM model.",
                  "title": "Max Context Length"
                },
                "azimuthNodeGroupSelector": {
                  "description": "Optional name of node group defined in Azimuth UI to schedule inference engine on.",
                  "title": "Node Group",
                  "default": ""
                }
              }
            }
          }
        }
      }
    }
  }
}
